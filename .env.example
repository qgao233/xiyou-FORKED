# ============================================================
# 小轩西游 Docker 环境变量配置
# 复制此文件为 .env 并修改对应值
# ============================================================

# ----------------------------------------------------------
# Web 服务配置
# ----------------------------------------------------------
# Web 服务对外暴露端口
WEB_PORT=8080

# 站点域名或 IP（用于生成游戏内链接）
# 本地开发用 localhost，公网部署填域名或公网 IP
SITE_HOST=localhost

# ----------------------------------------------------------
# MySQL 数据库配置
# ----------------------------------------------------------
# 数据库 root 密码
MYSQL_PASSWORD=root

# 数据库用户（默认 root）
MYSQL_USER=root

# 数据库对外暴露端口（宿主机端口，避免与本地 MySQL 冲突）
DB_PORT=3307

# 游戏数据库名称（一般无需修改）
MYSQL_DB_XXJY=xxjyuser
MYSQL_DB_XYY=xyy
